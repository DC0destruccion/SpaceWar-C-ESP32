<Project>
  <PropertyGroup>
    <!-- El runtime se copia a la carpeta de salida: el jugador no necesita instalar .NET. -->
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <!-- Se conserva la carpeta completa para cargar DLL nativas y archivos de configuración. -->
    <PublishSingleFile>false</PublishSingleFile>
    <!-- No se recortan bibliotecas: Windows Forms y SqlClient utilizan carga dinámica. -->
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\portatil\</PublishDir>
  </PropertyGroup>
</Project>
